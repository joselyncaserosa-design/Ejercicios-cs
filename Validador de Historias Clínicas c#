using System;

class Program
{
    static void Main()
    {
        try
        {
            Console.Write("Ingrese el número de historia clínica: ");
            int numeroHistoria = int.Parse(Console.ReadLine());

            Console.WriteLine("Número de historia clínica " + numeroHistoria + " registrado correctamente.");
        }
        catch (FormatException)
        {
            Console.WriteLine("Error: Debe ingresar un valor numérico, no se permiten letras ni símbolos.");
        }
        catch (Exception)
        {
            Console.WriteLine("Ocurrió un error inesperado.");
        }

        Console.WriteLine("\nPresione cualquier tecla para salir...");
        Console.ReadKey();
    }
}
