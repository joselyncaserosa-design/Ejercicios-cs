using System;
using System.IO;

class Usuario
{
    public string Nombre { get; set; }
    public string Password { get; set; }
}

class Cita
{
    public string Paciente { get; set; }
    public string Fecha { get; set; }
    public string Hora { get; set; }
}

class Program
{
    static void Main()
    {
        Usuario admin = new Usuario { Nombre = "admin", Password = "123" };

        Console.WriteLine("--- LOGIN DEL SISTEMA ---");
        Console.Write("Usuario: ");
        string user = Console.ReadLine();
        Console.Write("Contraseña: ");
        string pass = Console.ReadLine();

        if (user == admin.Nombre && pass == admin.Password)
        {
            MenuPrincipal();
        }
        else
        {
            Console.WriteLine("Acceso denegado.");
        }
    }

    static void MenuPrincipal()
    {
        string opcion = "";
        while (opcion != "3")
        {
            Console.WriteLine("\n--- MENU DE CITAS ---");
            Console.WriteLine("1. Registrar Cita");
            Console.WriteLine("2. Ver Citas Guardadas");
            Console.WriteLine("3. Salir");
            Console.Write("Seleccione una opción: ");
            opcion = Console.ReadLine();

            try
            {
                switch (opcion)
                {
                    case "1":
                        RegistrarCita();
                        break;
                    case "2":
                        VerCitas();
                        break;
                    case "3":
                        Console.WriteLine("Saliendo del sistema...");
                        break;
                    default:
                        Console.WriteLine("Opción no válida.");
                        break;
                }
            }
            catch (Exception ex)
            {
                Console.WriteLine("Error: " + ex.Message);
            }
        }
    }

    static void RegistrarCita()
    {
        Cita nuevaCita = new Cita();
        Console.Write("Nombre del Paciente: ");
        nuevaCita.Paciente = Console.ReadLine();
        Console.Write("Fecha (DD/MM/AAAA): ");
        nuevaCita.Fecha = Console.ReadLine();
        Console.Write("Hora (HH:MM): ");
        nuevaCita.Hora = Console.ReadLine();

        string datos = nuevaCita.Paciente + "," + nuevaCita.Fecha + "," + nuevaCita.Hora;
        
        File.AppendAllText("citas.txt", datos + Environment.NewLine);
        Console.WriteLine("Cita guardada correctamente.");
    }

    static void VerCitas()
    {
        if (File.Exists("citas.txt"))
        {
            Console.WriteLine("\n--- LISTADO DE CITAS ---");
            string[] lineas = File.ReadAllLines("citas.txt");
            foreach (string linea in lineas)
            {
                string[] partes = linea.Split(',');
                Console.WriteLine("Paciente: " + partes[0] + " | Fecha: " + partes[1] + " | Hora: " + partes[2]);
            }
        }
        else
        {
            Console.WriteLine("No hay citas registradas aún.");
        }
    }
}

